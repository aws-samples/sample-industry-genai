# AWS Configuration
# Replace with your actual AWS credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock Model Configuration
# The system will automatically find the best available model
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Agent Runtime Configuration (for production deployment)
AGENT_RUNTIME_ENDPOINT=localhost:8080
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-agent-name-here

# Legal Analysis Configuration
RISK_THRESHOLD=0.7

# Logging Configuration
LOG_LEVEL=INFO

# Security Note: Never commit actual credentials to version control
# Copy this file to .env and replace with your actual values